{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "printf 'allowBuilds:\\n  \"@parcel/watcher\": false\\n  esbuild: true\\n' > pnpm-workspace.yaml && npx -y pnpm@12.4.0 install --no-frozen-lockfile",
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
