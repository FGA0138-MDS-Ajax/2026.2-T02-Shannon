# Esse arquivo é um exemplo de variáveis de ambiente para o projeto. 
# Para utilizá-lo, crie um arquivo chamado .env nesta pasta e copie as
# variáveis de ambiente deste arquivo para o novo arquivo.

DATABASE_URL="postgres://habbit:habbit@localhost:5432/habbit"
# Em produção (Neon), use a URL direta (sem -pooler) para rodar migrações no build.
# Localmente pode ficar vazio (o Alembic usa DATABASE_URL).
DIRECT_DATABASE_URL=

# Origens permitidas no CORS separadas por vírgula (sem barra no final).
# Vazio localmente permite todas as origens (*). Em produção, informe a URL da PWA.
CORS_ORIGINS=

JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=minutos
REFRESH_TOKEN_EXPIRE_DAYS=dias

# Armazenamento de fotos (use STORAGE_BACKEND=memory localmente sem R2)
STORAGE_BACKEND=memory
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
PHOTO_URL_EXPIRE_MINUTES=30
