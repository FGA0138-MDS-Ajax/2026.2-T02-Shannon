# Esse arquivo é um exemplo de variáveis de ambiente para o projeto. 
# Para utilizá-lo, crie um arquivo chamado .env nesta pasta e copie as
# variáveis de ambiente deste arquivo para o novo arquivo.

DATABASE_URL="postgres://habbit:habbit@localhost:5432/habbit"
# Em produção (Neon), use a URL direta (sem -pooler) para rodar migrações no build.
# Localmente pode ficar vazio (o Alembic usa DATABASE_URL).
DIRECT_DATABASE_URL=

# Origens permitidas no CORS separadas por vírgula (sem barra no final).
# Vazio localmente permite todas as origens (*).
# OBRIGATÓRIA em produção (informe a URL da PWA): a API não sobe sem ela nem com "*".
CORS_ORIGINS=

# Segredo usado para assinar os JWT. Mínimo de 32 caracteres.
# Para gerar um: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=minutos
REFRESH_TOKEN_EXPIRE_DAYS=dias

# Só tem efeito em produção: "true" reabre /docs, /redoc e /openapi.json
# (ex.: apresentações). Deixe desligada no uso normal. Fora de produção a
# documentação já fica aberta.
# ENABLE_DOCS=false

# Não defina VERCEL_ENV aqui: a própria Vercel preenche ("production", "preview"...).
# Com VERCEL_ENV=production a API passa a exigir CORS_ORIGINS e fecha a documentação.

# Armazenamento de fotos (use STORAGE_BACKEND=memory localmente sem R2)
STORAGE_BACKEND=memory
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
PHOTO_URL_EXPIRE_MINUTES=30
